# Public environment variables (client-side readable). Do not put secrets here.

# API base (optional). If omitted, the app uses relative paths and falls back to in-memory storage.
NEXT_PUBLIC_API_BASE=

# Optional aliases or miscellaneous values
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_NEXT_TELEMETRY_DISABLED=true
NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false
NEXT_PUBLIC_PORT=3000
NEXT_PUBLIC_TRUST_PROXY=false
NEXT_PUBLIC_LOG_LEVEL=info
NEXT_PUBLIC_HEALTHCHECK_PATH=/healthz

# Feature flags
# Either JSON: {"showNewChip": true}
# Or comma-separated key=value: showNewChip=true,exampleExperiment=false
NEXT_PUBLIC_FEATURE_FLAGS=
NEXT_PUBLIC_EXPERIMENTS_ENABLED=false
